# Copy to .env and adjust for local / EC2 deploys.
# Docker Compose reads this file automatically for variable substitution.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=socialogy

# --- Backend ---
PORT=8080
CORS_ORIGIN=*
UPLOAD_PATH=images
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=socialogy
# Schema is owned by TypeORM migrations. DB_SYNC is ignored (always off).
DB_SYNC=0
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1h

# --- Frontend ---
# Baked into the Vite bundle at build time (browser calls this URL).
VITE_API_URL=http://localhost:8080
