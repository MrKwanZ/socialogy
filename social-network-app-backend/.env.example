PORT=8080
CORS_ORIGIN=*
UPLOAD_PATH=images

# Use localhost when running Nest on the host against Docker Postgres.
# docker-compose.yml overrides DB_HOST to "postgres" for the backend container.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=socialogy
# Schema is owned by TypeORM migrations. DB_SYNC is ignored (always off).
DB_SYNC=0

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1h

# Backup (host tools against local Docker Postgres):
#   docker compose exec postgres pg_dump -U postgres socialogy > backup.sql
# Restore:
#   docker compose exec -T postgres psql -U postgres socialogy < backup.sql
