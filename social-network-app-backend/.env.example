# Legacy Express / MongoDB backend (Phase 8 retirement pending).
#
# Prefer NestJS + PostgreSQL for local and Docker stacks:
#   social-network-app-backend-nest/.env.example
#   root docker-compose.yaml
#
# This package is retained for contract tests and rollback until cutover.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<appName>
JWT_SECRET=your_jwt_secret_here
PORT=8080
